# ============================================================
# AI Daily Digest — configuration
# 1. Copy this file and rename the copy to:  config.env
# 2. Fill in the values below (no quotes needed)
# 3. NEVER share or upload config.env — it contains your passwords
# See README.md for step-by-step instructions for each value.
# ============================================================

# --- Gmail account that SENDS the digest (REQUIRED) ---
GMAIL_SENDER=your.address@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password).
# Spaces are fine, e.g.  abcd efgh ijkl mnop
GMAIL_APP_PASSWORD=

# Who RECEIVES the digest (REQUIRED). One or more addresses, comma-separated.
GMAIL_RECIPIENTS=you@example.com,friend@example.com

# --- AI curation ---
# Google Gemini API key (REQUIRED for good quality, free tier is enough).
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic Claude API key (OPTIONAL, used only if Gemini fails; paid).
# Leave blank if you don't have one.
ANTHROPIC_API_KEY=

# --- Your timezone (OPTIONAL) ---
# Hours ahead of (+) or behind (-) UTC. Examples:
#   Bangladesh 6 | India 5.5 | UK 0 | Germany 1 | New York -5 | Los Angeles -8
TIMEZONE_OFFSET_HOURS=6
# Label shown in the email, e.g. Asia/Dhaka. Leave blank to show "UTC+6".
TIMEZONE_LABEL=
